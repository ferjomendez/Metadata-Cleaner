# Copy to .env and edit:   cp .env.example .env && chmod 600 .env
# .env is git-ignored. Never commit it.

# --- network ---------------------------------------------------------------
# LAN IP of the server. The app is published ONLY on this address.
# Example value, replace with your server's LAN IP:
BIND_ADDRESS=192.168.1.10
HOST_PORT=8480

# --- secrets ---------------------------------------------------------------
# Generate with:  openssl rand -hex 32
SESSION_SECRET=

# Set to true only when the app is served over HTTPS (for example behind
# Nginx Proxy Manager); then cookies get the Secure flag.
COOKIE_SECURE=false
# Extra allowed browser origins, comma separated, e.g. https://cleaner.example.lan
# (only needed behind a reverse proxy that changes the Host header).
TRUSTED_ORIGINS=
# Only behind a reverse proxy: IP the proxy connects from, so per-client rate
# limits see the real client address. Leave as is for direct LAN access.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- limits (tuned for a 4-core / 7 GB host shared with other services) -----
MAX_FILE_MB=500
MAX_FILES_PER_BATCH=20
MAX_BATCH_MB=2048
# Hard quota for uploads + results on disk, and minimum free disk to keep.
WORK_QUOTA_GB=10
MIN_FREE_DISK_GB=20
# 1 or 2. Each running file uses up to ~1.5 GB RAM in the worker.
MAX_CONCURRENT_JOBS=1
FILE_TIMEOUT_SECONDS=300
MAX_IMAGE_MEGAPIXELS=100
MAX_PDF_PAGES=300
MAX_MEDIA_DURATION_SECONDS=14400
MAX_ARCHIVE_ENTRIES=10000
MAX_ARCHIVE_UNCOMPRESSED_MB=1024
MAX_ARCHIVE_RATIO=200

# --- retention -------------------------------------------------------------
# Cleaned files are deleted this many minutes after a job finishes.
RETENTION_MINUTES=60
# History entries (names, formats, status; no files) are kept this many days.
HISTORY_RETENTION_DAYS=30

# --- sessions --------------------------------------------------------------
SESSION_IDLE_MINUTES=480
SESSION_MAX_HOURS=24
